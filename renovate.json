{
  "extends": ["github>whatever-company/renovate-config"],
  "automerge": true,
  "gitLabAutomerge": true,
  "prConcurrentLimit": 5,
  "ignoreDeps": [
    "slate",
    "slate-hyperscript",
    "slate-react",
    "slate-schema-violations"
  ],
  "packageRules": [
    {
      "packageNames": ["react", "react-dom"],
      "groupName": "React"
    }
  ]
}
