{
  "name": "@whatever-company/slate-code-block",
  "description": "A Slate plugin to handle code blocks editing. Fork from GitbookIO/slate-edit-code",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "repository": "git@github.com:whatever-company/slate-code-block.git",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "main": "./lib/index.js",
  "types": "./index.d.ts",
  "files": [
    "lib",
    "index.d.ts"
  ],
  "dependencies": {
    "is-hotkey": "0.1.8"
  },
  "engines": {
    "npm": ">=6.0.0"
  },
  "peerDependencies": {
    "slate": "^0.47.3",
    "slate-react": "^0.22.4",
    "slate-schema-violations": "^0.1.39"
  },
  "devDependencies": {
    "@types/slate": "0.47.16",
    "@types/slate-react": "0.22.9",
    "@zarv1k/slate-hyperprint": "3.2.0",
    "esbuild": "0.27.4",
    "immutable": "3.8.4",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "slate": "0.47.9",
    "slate-hyperscript": "0.13.9",
    "slate-react": "0.22.10",
    "slate-schema-violations": "0.1.39",
    "typescript": "7.0.2"
  },
  "scripts": {
    "lint": "oxlint lib/",
    "typecheck": "tsc -p tsconfig.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --import ./tests/loader.js --test ./tests/all.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "keywords": [
    "slate"
  ]
}
